{:paths ["src" "resources"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         datalevin/datalevin       {:mvn/version "1.0.0"}
         ;; Published 1.0.8 carries syncopate's client/server (dtlv://) support.
         com.github.crinklywrappr/syncopate {:mvn/version "1.0.8"}
         integrant/integrant       {:mvn/version "1.0.1"}
         ring/ring-jetty-adapter   {:mvn/version "1.12.2"}
         hiccup/hiccup             {:mvn/version "1.0.5"}
         metosin/malli             {:mvn/version "0.16.4"}}
 :aliases
 {:run {:main-opts ["-m" "hr.main"]
        :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}
  ;; Networked Datalevin server (the "transactor" this app talks to over dtlv://).
  ;; Default creds datalevin/datalevin; db files land under data/dtlv-root.
  :server {:main-opts ["-m" "datalevin.main" "serv"
                       "-r" "data/dtlv-root" "-p" "8898"]
           :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}
  :bench {:extra-deps {criterium/criterium {:mvn/version "0.4.6"}}
          :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                      "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}}}
