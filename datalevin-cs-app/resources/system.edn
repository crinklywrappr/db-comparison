;; Client/server variant: the only change from the embedded app is that the
;; connection "path" is a dtlv:// URI pointing at a networked Datalevin server
;; (started via `clojure -M:server`), not a local LMDB directory. Everything
;; downstream — schema/seed/queries AND syncopate's migrations — is identical,
;; proving the app (and the migration tool) are storage-location-agnostic.
{:hr.db/conn     {:path "dtlv://datalevin:datalevin@localhost:8898/hr-db"}
 :hr.db/migrated {:conn #ig/ref :hr.db/conn
                  :path "dtlv://datalevin:datalevin@localhost:8898/hr-db"}
 :hr.web/handler {:db #ig/ref :hr.db/migrated}
 :hr.web/server  {:handler #ig/ref :hr.web/handler
                  :port 3004}}
