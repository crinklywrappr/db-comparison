;; Split :employee/name into :employee/given-name + :employee/family-name via a
;; data-transform fn (referenced by fully-qualified symbol — syncopate resolves it
;; to a real var at run time), then REMOVE the old attribute entirely: the
;; `:schema/remove` step retracts every :employee/name datom and drops the schema
;; entry. After this runs, the single-name shape exists nowhere, at any time.
;; No idempotency guard is needed — syncopate applies each migration exactly once.
{:up   [{:schema {:employee/given-name  {:db/valueType :db.type/string}
                  :employee/family-name {:db/valueType :db.type/string}}}
        hr.migration-fns/split-names
        {:schema/remove [:employee/name]}]
 :down [{:schema {:employee/name {:db/valueType :db.type/string}}}
        hr.migration-fns/join-names
        {:schema/remove [:employee/given-name :employee/family-name]}]}
